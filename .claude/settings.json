{
  "permissions": {
    "allow": [
      "Bash(git status *)", "Bash(git diff *)", "Bash(git log *)", "Bash(git show *)",
      "Bash(git branch *)", "Bash(git switch *)", "Bash(git checkout *)", "Bash(git add *)",
      "Bash(git commit *)", "Bash(git fetch *)", "Bash(git pull *)", "Bash(git merge *)",
      "Bash(git push *)", "Bash(git rev-parse *)", "Bash(git ls-files *)",
      "Bash(npm install)", "Bash(npm ci)", "Bash(npm run build)", "Bash(npm run dev)",
      "Bash(npm run lint)", "Bash(node -v)", "Bash(gh auth status)"
    ],
    "ask": [
      "Bash(git push)", "Bash(git push * main)", "Bash(git push * HEAD:main)",
      "Bash(git push * main:main)", "Bash(git restore *)", "Bash(git stash *)"
    ],
    "deny": [
      "Bash(git push --force *)", "Bash(git push -f *)", "Bash(git push * --force)",
      "Bash(git push * -f)", "Bash(git push --force-with-lease *)",
      "Bash(git push * --force-with-lease)", "Bash(git push * --delete *)",
      "Bash(git reset --hard *)", "Bash(git clean *)", "Bash(git rebase *)",
      "Bash(git branch -D *)", "Read(.env)", "Read(.env.local)",
      "Read(.env.development.local)", "Read(.env.production.local)"
    ]
  }
}
